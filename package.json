{
  "name": "puppetforge",
  "version": "0.30.2",
  "type": "module",
  "description": "2D 종이인형 애니메이션 툴과 게임용 런타임. Puppet JSON 하나로 편집기와 게임이 같은 데이터를 쓴다.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "phaser": "^3.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "author": "Bell7080",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bell7080/WebGLE.git"
  },
  "homepage": "https://github.com/Bell7080/WebGLE#readme",
  "bugs": {
    "url": "https://github.com/Bell7080/WebGLE/issues"
  },
  "keywords": [
    "2d",
    "animation",
    "skeletal",
    "mesh",
    "phaser",
    "game",
    "puppet",
    "cutout"
  ],
  "sideEffects": false,
  "types": "./dist-lib/types/runtime/index.d.ts",
  "module": "./dist-lib/index.js",
  "exports": {
    ".": {
      "types": "./dist-lib/types/runtime/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./phaser": {
      "types": "./dist-lib/types/runtime/phaser.d.ts",
      "import": "./dist-lib/phaser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE",
    "docs/puppet-json.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "phaser": ">=3.80.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  }
}
